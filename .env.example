# 로컬 개발용. 복사해서 .env 로 사용 (.env 는 커밋 금지)
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx
# 호스트 포트 충돌 시 변경 (기본 3306 / 6379)
# MYSQL_PORT=3306
# REDIS_PORT=6379
# 로컬 기본값(./uploads, http://localhost:8080/uploads) 을 바꿀 때만 설정
# FILE_UPLOAD_PATH=./uploads
# FILE_BASE_URL=http://localhost:8080/uploads
# 부하 테스트에서 Redis ON/OFF 비교할 때만 false 로 설정 (운영은 항상 true)
# LIMITED_REDIS_ENABLED=true
