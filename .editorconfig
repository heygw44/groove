root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.java]
# 네이버 핵데이 Java 컨벤션: 하드탭, 탭 크기 4, 최대 120자
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,yml,yaml,css,md}]
indent_size = 2
